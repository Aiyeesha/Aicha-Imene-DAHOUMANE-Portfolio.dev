# .env.example
# -------------
# Copier ce fichier en .env.local et remplir les valeurs.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur — ne jamais y mettre de secrets.
# Les autres variables sont server-only.
#
# Générer des secrets : openssl rand -base64 32

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>          # server-only, ne jamais exposer

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>                      # server-only

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://example.com              # URL canonique, sans slash final
NEXT_PUBLIC_SITE_NAME=Portfolio
NEXT_PUBLIC_OG_NAME=Prénom Nom
NEXT_PUBLIC_OG_HEADLINE=                              # optionnel, sous-titre des images OG/Twitter
NEXT_PUBLIC_BRAND_INITIALS=                           # optionnel, initiales du logo Navbar (défaut : A)
NEXT_PUBLIC_SITE_LASTMOD=                             # optionnel, fige le lastModified du sitemap (YYYY-MM-DD) ; défaut : date du jour

# ── Contact ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
FORMHOOK_ENDPOINT=https://formhook.app/f/<form-key>
FORMHOOK_AUTH_TOKEN=<server-to-server token, généré depuis Formhook → Paramètres du formulaire>

# ── Réseaux sociaux ───────────────────────────────────────────────────────────
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/<handle>
NEXT_PUBLIC_SAME_AS=https://linkedin.com/in/<handle>,https://github.com/<handle>

# ── CV & Avatar ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CV_PDF_URL=                               # optionnel, fallback : /cv/Aicha-Imene-DAHOUMANE-CV-{locale}-{track}.pdf
                                                      # doit contenir {locale} et/ou {track}, sinon ignorée ; chemin absolu (/cv/…) ou URL complète
# NEXT_PUBLIC_CV_URL / NEXT_PUBLIC_PROFILE_PDF_URL : alias legacy lus en fallback de NEXT_PUBLIC_CV_PDF_URL — ne pas utiliser
NEXT_PUBLIC_AVATAR_URL=                               # optionnel, fallback : /avatar.webp

# ── Calendly ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/<handle>

# ── Admin (/admin HTTP Basic Auth) ───────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<secret-32-chars>

# ── Cron Vercel (/api/cron/ping) ──────────────────────────────────────────────
CRON_SECRET=<secret-32-chars>

# ── Cache invalidation (/api/cache/invalidate) ────────────────────────────────
CACHE_INVALIDATE_SECRET=<secret-32-chars>

# ── ISR on-demand (/api/revalidate) ───────────────────────────────────────────
# Secret partagé avec le webhook Supabase (header x-revalidate-secret)
REVALIDATE_SECRET=<secret-32-chars>

# ── Témoignages (lien d'invitation HMAC) ─────────────────────────────────────
# Le token sert de clé HMAC — il n'est JAMAIS exposé dans les URLs publiques.
# Pour générer un lien d'invitation (valide 7 jours) :
#   curl -X POST /api/admin/testimonial-invite \
#     -H "Authorization: Bearer <ADMIN_PASSWORD>" \
#     -H "Content-Type: application/json" \
#     -d '{"locale":"fr","days":7}'
TESTIMONIAL_SUBMIT_TOKEN=<secret-32-chars>

# ── Rate-limiting contact (optionnel) ────────────────────────────────────────
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600                 # défaut : 600 s (10 min)
CONTACT_RATE_LIMIT_MAX_REQUESTS=5                     # défaut : 5 requêtes

# ── Sécurité ─────────────────────────────────────────────────────────────────
IP_HASH_SALT=<secret-32-chars>                        # sel pour pseudonymisation SHA-256 des IP

# ── Heartbeat externe (dead-man's switch) ────────────────────────────────────
# URL pingée après chaque exécution réussie du cron /api/cron/ping.
# Si le service ne reçoit pas de ping pendant une fenêtre configurable, il
# émet une alerte (email/Discord) indépendante de GitHub et de Vercel.
# Exemple : https://hc-ping.com/<uuid> (healthchecks.io, plan gratuit)
HEALTHCHECK_URL=                                      # optionnel — laisser vide pour désactiver

# ── Alertes webhook (optionnel) ───────────────────────────────────────────────
# URL POST compatible Discord/Slack/ntfy — reçoit une alerte si l'état global != "operational"
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# URL POST compatible Discord/Slack/ntfy — reçoit une alerte sur rapport CSP (rate-limité)
# CSP_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ── Script local scripts/apply-supabase-sql.ts (non requis par l'app) ─────────
# SUPABASE_PROJECT_REF=<project-ref>                  # Settings > General > Reference ID
# SUPABASE_ACCESS_TOKEN=<personal-access-token>       # https://supabase.com/dashboard/account/tokens

# ── Feature flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOW_TESTIMONIALS=false                   # true pour afficher la section témoignages
