#!/usr/bin/env sh
# Pre-commit hook: scans staged changes for secrets with gitleaks
# (https://github.com/gitleaks/gitleaks).
#
# Install:
#   macOS  : brew install gitleaks
#   Linux  : see https://github.com/gitleaks/gitleaks#installing
#
# Temporary bypass (not recommended): SKIP=gitleaks git commit ...

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner
else
  echo "⚠️  gitleaks non trouvé — scan de secrets ignoré."
  echo "   Installez-le pour activer la protection : https://github.com/gitleaks/gitleaks"
fi

# Changelog reminder: warns (without blocking) when code or content files are
# staged without CHANGELOG.md. Only a warning: some commits (typo, pure
# refactor, regenerated file) legitimately have nothing to add.
STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -qE '^(app|components|content|i18n|lib|messages)/' \
  && ! echo "$STAGED" | grep -q '^CHANGELOG.md$'; then
  echo "📝 Rappel : ce commit touche du code/contenu mais pas CHANGELOG.md."
  echo "   Si le changement est notable, ajoute une entrée avant de committer."
fi
